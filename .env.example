# ============================================================
# Analytics Dashboard - Variables de entorno (raíz)
# Copia este archivo a .env y completa los valores
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=analytics
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- API Keys externas (opcionales, mejoran rate limits) ---
# GitHub: https://github.com/settings/tokens  (scope: public_repo)
GITHUB_TOKEN=
# Product Hunt: https://www.producthunt.com/v2/oauth/applications  (Dev Token)
PRODUCT_HUNT_TOKEN=

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (frontend Next.js) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
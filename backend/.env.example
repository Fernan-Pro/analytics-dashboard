# ============================================================
# Backend - plantilla de entorno. Copia a .env y completa.
# ============================================================
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=analytics
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=tu_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- API Keys externas (opcionales, mejoran rate limits / desbloquean fuentes) ---
# GitHub: https://github.com/settings/tokens (scope: public_repo)
GITHUB_TOKEN=
# Product Hunt: https://www.producthunt.com/v2/oauth/applications (Dev Token)
PRODUCT_HUNT_TOKEN=

# --- Celery / Redis (broker) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0